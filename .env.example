# Public URL of this app (must match OAuth redirect URIs). Local server is HTTPS.
# On Vercel this is set automatically from VERCEL_URL if you leave it blank.
APP_BASE_URL=https://127.0.0.1:43147

# HMAC secret for the session cookie. Required on Vercel so every serverless
# instance can verify the same cookie (sessions are not stored on disk there).
# SESSION_SECRET=replace-me-with-a-long-random-string

# Optional API key for MCP and the SDK (default: aegis_demo_key)
# AEGIS_API_KEY=aegis_demo_key

# Gmail — Google Cloud OAuth client (Web application)
# Redirect: {APP_BASE_URL}/api/oauth/gmail/callback
# Enable Gmail API. Scopes: gmail.readonly, gmail.compose, gmail.send, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack — Slack app OAuth (bot)
# Redirect: {APP_BASE_URL}/api/oauth/slack/callback
# Bot scopes: chat:write, channels:read, channels:join, groups:read, im:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APPROVALS_CHANNEL=#aegis-approvals
SLACK_ALERTS_CHANNEL=#security
SLACK_AUDIT_CHANNEL=#aegis-audit

# Notion — public integration OAuth
# Redirect: {APP_BASE_URL}/api/oauth/notion/callback
# After connect, share a page or database with the integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# GitHub — OAuth App
# Callback: {APP_BASE_URL}/api/oauth/github/callback
# Scopes: repo, read:user, user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: fixture merge target when GitHub has no open PRs
# GITHUB_DEMO_REPO=owner/repo
# GITHUB_DEMO_PR=1
